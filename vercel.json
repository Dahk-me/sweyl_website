{
  "redirects": [
    {
      "source": "/pro",
      "missing": [{ "type": "host", "value": "pro.sweyl.com" }],
      "destination": "https://pro.sweyl.com/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/((?!assets|api|pro.html|mentions-legales.md).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    }
  ]
}
